{
  "name": "slugterra-luminous-deep",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A playable 3D cavern expedition with elemental slug combat and RPG progression.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test --experimental-test-isolation=none tests/*.test.js",
    "test:browser": "node tests/browser-smoke.cjs",
    "package:game": "npm run build && node scripts/package-game.mjs",
    "test:campaign": "node tests/campaign-browser.cjs",
    "test:portable": "node tests/portable-smoke.cjs",
    "test:lifecycle": "node tests/lifecycle-browser.cjs",
    "test:collision": "node tests/collision-browser.cjs",
    "test:camera": "node tests/camera-browser.cjs",
    "verify:models": "node scripts/model-assets.mjs",
    "test:expansion": "node tests/expansion-browser.cjs",
    "test:abilities": "node tests/abilities-browser.cjs",
    "test:touch": "node tests/touch-browser.cjs",
    "test:elements": "node tests/elements-browser.cjs",
    "build:hosted": "node scripts/build-hosted.mjs",
    "db:generate": "drizzle-kit generate",
    "test:accounts": "node --test tests/account-saves.test.js",
    "test:accounts:browser": "node tests/accounts-browser.cjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "drizzle-orm": "^0.45.2",
    "three": "0.180.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "playwright": "1.56.1",
    "vite": "7.1.12",
    "wrangler": "^4.92.0"
  }
}
